{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "bash@latest",
    "git@latest",
    "gh@latest",
    "ghq@latest",
    "neovim@latest",
    "tmux@latest",
    "starship@latest",
    "ripgrep@latest",
    "fd@latest",
    "fzf@latest",
    "eza@latest",
    "bat@latest",
    "delta@latest",
    "jq@latest",
    "lazygit@latest",
    "zoxide@latest",
    "yazi@latest",
    "claude-code@latest",
    "colima@latest",
    "zsh-autosuggestions@latest",
    "nodejs@22",
    "uv@latest"
  ],
  "shell": {
    "init_hook": [
      "export NPM_CONFIG_PREFIX=$HOME/.npm-global",
      "export PATH=$HOME/.npm-global/bin:$PATH",
      "export PATH=$HOME/.local/bin:$PATH",
      "command -v opencode >/dev/null 2>&1 || npm install -g opencode-ai",
      "echo 'Devbox global packages loaded!'"
    ]
  }
}
